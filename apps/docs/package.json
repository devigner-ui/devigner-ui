{
  "name": "@devignerui/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:registry",
    "dev": "node -e \"const fs=require('fs');if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "prebuild": "npm run generate:registry",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:registry": "tsc --noEmit -p registry/tsconfig.json",
    "generate:registry": "node scripts/generate-registry.mjs",
    "generate:registry:check": "node scripts/generate-registry.mjs --check",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@devignerui/shared": "workspace:*",
    "@devignerui/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "^14.2.0",
    "fumadocs-ui": "^15.0.0",
    "geist": "^1.7.2",
    "motion": "^11.18.0",
    "next": "^15.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reicon-react": "^1.2.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postcss": "^8.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vitest": "^3"
  }
}
