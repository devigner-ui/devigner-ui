# Devigner UI Environment Variables

# Creem Payment Integration
# Get these from https://creem.io/dashboard
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Creem Product IDs
# Create these products in your Creem dashboard first, then paste the IDs here
CREEM_PRODUCT_BASIC_MONTHLY=
CREEM_PRODUCT_BASIC_YEARLY=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_ULTRA_MONTHLY=
CREEM_PRODUCT_ULTRA_YEARLY=
CREEM_PRODUCT_LIFETIME=

# Discord
# Webhook for the #requests channel (Channel settings > Integrations > Webhooks).
# Server-only: never expose it with a NEXT_PUBLIC_ prefix.
DISCORD_REQUESTS_WEBHOOK_URL=
# Bot token for the public /requests board, which reads the forum's posts and
# their status tags. The bot needs View Channel + Read Message History on the
# requests forum. Server-only.
DISCORD_BOT_TOKEN=
# Webhook for the #changelog announcement channel, used only by
# `pnpm changelog:publish` (docs/changelog.md). Not needed on Vercel.
DISCORD_UPDATES_WEBHOOK_URL=
# Webhook for a private test channel, used by `pnpm changelog:test` to try a
# post before the real one. Same server, so the emojis resolve.
DISCORD_CHANGELOG_TEST_WEBHOOK_URL=

# Request form spam protection (docs/component-requests.md). Each part is off
# until its keys are set.
# Cloudflare Turnstile: dash.cloudflare.com > Turnstile > Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis rate limit. The Vercel Marketplace integration fills in the
# KV_REST_API_* pair; a database made on upstash.com gives UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
