{
  "$schema": "https://turborepo.dev/schema.json",
  // Windows: turbo's stream writer aborts (0xC0000409) when it has a TTY *and*
  // npm_command/npm_config_user_agent are set, i.e. every `pnpm dev`/`pnpm build`.
  // TUI is unaffected, and turbo still falls back to stream when there is no TTY (CI).
  // 2.10.13 ignores this key, so the scripts pass --ui=tui too - keep both.
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Vercel project vars. Turbo's strict env mode hides anything not
      // listed here from the build. NEXT_PUBLIC_* is passed on its own.
      "env": [
        "CREEM_API_KEY",
        "CREEM_WEBHOOK_SECRET",
        "CREEM_PRODUCT_BASIC_MONTHLY",
        "CREEM_PRODUCT_BASIC_YEARLY",
        "CREEM_PRODUCT_PRO_MONTHLY",
        "CREEM_PRODUCT_PRO_YEARLY",
        "CREEM_PRODUCT_ULTRA_MONTHLY",
        "CREEM_PRODUCT_ULTRA_YEARLY",
        "CREEM_PRODUCT_LIFETIME",
        "KV_URL",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_REST_API_READ_ONLY_TOKEN",
        "REDIS_URL",
        "DISCORD_REQUESTS_WEBHOOK_URL",
        "DISCORD_BOT_TOKEN",
        "TURNSTILE_SECRET_KEY"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
