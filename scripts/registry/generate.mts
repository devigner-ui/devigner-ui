import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { descriptors } from "./descriptors.mts";
import { guides } from "./guides.mts";

const root = resolve(import.meta.dirname, "../..");
const outputFile = resolve(root, "apps/docs/lib/registry.ts");
const namesFile = resolve(root, "apps/docs/lib/registry-names.ts");

export function copyPasteSource(sourceFile: string) {
  // LF always: a Windows checkout (core.autocrlf) must not ship CRLF files.
  return readFileSync(resolve(root, sourceFile), "utf8")
    .replaceAll("\r\n", "\n")
    .replaceAll('"../lib/easing"', '"devignerui/motion"')
    .replaceAll('"../lib/hooks/use-controllable-state"', '"devignerui/hooks"')
    .replaceAll('"../lib/hooks/use-hover-capable"', '"devignerui/hooks"')
    .replaceAll('"../lib/hooks/use-reduced-motion"', '"devignerui/hooks"')
    .replaceAll('"../lib/menu-path"', '"devignerui/menu-path"')
    .replaceAll('"../lib/date-range"', '"devignerui/date-range"');
}

// tryIt, stageAlign and requestId are optional per descriptor; the as-const
// tuple only types them on the entries that set them.
const extras = (descriptor: (typeof descriptors)[number]) =>
  descriptor as { tryIt?: string; stageAlign?: "center" | "end"; requestId?: string };

export function renderRegistry() {
  const slugs = descriptors.map((descriptor) => JSON.stringify(descriptor.slug)).join(" | ");
  const components = Object.fromEntries(descriptors.map((descriptor) => [descriptor.slug, {
    slug: descriptor.slug,
    name: descriptor.name,
    description: descriptor.description,
    category: descriptor.category,
    addedAt: descriptor.addedAt,
    since: descriptor.since,
    ...(extras(descriptor).tryIt ? { tryIt: extras(descriptor).tryIt } : {}),
    stageAlign: extras(descriptor).stageAlign ?? "center",
    ...(extras(descriptor).requestId ? { requestId: extras(descriptor).requestId } : {}),
    variants: descriptor.variants,
    props: descriptor.props.map(([name, type, defaultValue, description]) => ({ name, type, default: defaultValue, description })),
    code: copyPasteSource(descriptor.sourceFile),
    usage: descriptor.examples.standard,
    customUsage: descriptor.examples.custom,
    dependencies: descriptor.dependencies,
    transformations: descriptor.transformations,
    guide: guides[descriptor.slug],
  }]));

  return `// Generated by scripts/registry/generate.mts. Do not edit directly.\n\nexport type ComponentSlug = ${slugs};\n\nexport interface PropDef {\n  name: string;\n  type: string;\n  default: string;\n  description: string;\n}\n\nexport interface ComponentData {\n  slug: string;\n  name: string;\n  description: string;\n  category: string;\n  /** YYYY-MM-DD, when the component shipped. */\n  addedAt: string;\n  /** The devignerui release it first shipped in. */\n  since: string;\n  /** Stage caption hint: how to poke the live demo. */\n  tryIt?: string;\n  /** Vertical alignment on stages; "end" for panels that open upward. */\n  stageAlign: \"center\" | \"end\";\n  /** The Discord request post (its id) this component was built for. */\n  requestId?: string;\n  variants: readonly string[];\n  props: readonly PropDef[];\n  code: string;\n  usage: string;\n  customUsage?: string;\n  dependencies: readonly string[];\n  transformations: readonly string[];\n  notes?: readonly string[];\n  /** Written guidance: when to use it, keyboard, accessibility, theming, edge cases, recipes and fixes. */\n  guide: ComponentGuide;\n}\n\nexport interface ComponentGuide {\n  demo: string;\n  whenToUse: readonly string[];\n  whenNotToUse: readonly string[];\n  keyboard: readonly (readonly [string, string])[];\n  accessibility: readonly string[];\n  theming: readonly string[];\n  edgeCases: readonly string[];\n  recipes: readonly { title: string; description: string; code: string }[];\n  troubleshooting: readonly { question: string; answer: string }[];\n}\n\nexport const components: Record<string, ComponentData> = ${JSON.stringify(components, null, 2)};\n\nexport function getRegistryIndex() {\n  return Object.values(components).map((component) => ({\n    name: component.name,\n    type: \"registry:ui\" as const,\n    dependencies: component.dependencies,\n    registryDependencies: [],\n    files: [{ path: \`components/ui/\${component.slug}.tsx\`, type: \"registry:ui\" as const }],\n  }));\n}\n\nexport function getRegistryComponent(slug: string) {\n  const component = components[slug];\n  if (!component) return null;\n  return {\n    name: component.name,\n    type: \"registry:ui\" as const,\n    dependencies: component.dependencies,\n    registryDependencies: [],\n    files: [{ path: \`components/ui/\${component.slug}.tsx\`, content: component.code, type: \"registry:ui\" as const }],\n  };\n}\n`;
}

// Just slug and name, for client code that lists components (the MenuDock
// search) without pulling every component's source along.
export function renderNames() {
  const names = descriptors.map(({ slug, name }) => ({ slug, name }));
  return `// Generated by scripts/registry/generate.mts. Do not edit directly.\n\nexport const componentNames: readonly { slug: string; name: string }[] = ${JSON.stringify(names, null, 2)};\n`;
}

if (process.argv[1] && resolve(process.argv[1]) === resolve(import.meta.filename)) {
  for (const [file, output] of [[outputFile, renderRegistry()], [namesFile, renderNames()]]) {
    if (process.argv.includes("--check")) {
      if (!existsSync(file) || readFileSync(file, "utf8").replaceAll("\r\n", "\n") !== output) {
        console.error("Generated registry is stale. Run pnpm registry:generate.");
        process.exitCode = 1;
      }
    } else writeFileSync(file, output);
  }
}
