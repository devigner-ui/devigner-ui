import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { descriptors } from "./descriptors.mts";

const root = resolve(import.meta.dirname, "../..");
const outputFile = resolve(root, "apps/docs/lib/registry.ts");

export function copyPasteSource(sourceFile: string) {
  return readFileSync(resolve(root, sourceFile), "utf8")
    .replaceAll('"../lib/easing"', '"devignerui/motion"')
    .replaceAll('"../lib/hooks/use-controllable-state"', '"devignerui/hooks"')
    .replaceAll('"../lib/hooks/use-hover-capable"', '"devignerui/hooks"')
    .replaceAll('"../lib/hooks/use-reduced-motion"', '"devignerui/hooks"')
    .replaceAll('"../lib/menu-path"', '"devignerui/menu-path"')
    .replaceAll('"../lib/date-range"', '"devignerui/date-range"');
}

// tryIt and stageAlign are optional per descriptor; the as-const tuple only
// types them on the entries that set them.
const extras = (descriptor: (typeof descriptors)[number]) =>
  descriptor as { tryIt?: string; stageAlign?: "center" | "end" };

export function renderRegistry() {
  const slugs = descriptors.map((descriptor) => JSON.stringify(descriptor.slug)).join(" | ");
  const components = Object.fromEntries(descriptors.map((descriptor) => [descriptor.slug, {
    slug: descriptor.slug,
    name: descriptor.name,
    description: descriptor.description,
    category: descriptor.category,
    addedAt: descriptor.addedAt,
    ...(extras(descriptor).tryIt ? { tryIt: extras(descriptor).tryIt } : {}),
    stageAlign: extras(descriptor).stageAlign ?? "center",
    variants: descriptor.variants,
    props: descriptor.props.map(([name, type, defaultValue, description]) => ({ name, type, default: defaultValue, description })),
    code: copyPasteSource(descriptor.sourceFile),
    usage: descriptor.examples.standard,
    customUsage: descriptor.examples.custom,
    dependencies: descriptor.dependencies,
    transformations: descriptor.transformations,
  }]));

  return `// Generated by scripts/registry/generate.mts. Do not edit directly.\n\nexport type ComponentSlug = ${slugs};\n\nexport interface PropDef {\n  name: string;\n  type: string;\n  default: string;\n  description: string;\n}\n\nexport interface ComponentData {\n  slug: string;\n  name: string;\n  description: string;\n  category: string;\n  /** YYYY-MM-DD, when the component shipped. */\n  addedAt: string;\n  /** Stage caption hint: how to poke the live demo. */\n  tryIt?: string;\n  /** Vertical alignment on stages; "end" for panels that open upward. */\n  stageAlign: \"center\" | \"end\";\n  variants: readonly string[];\n  props: readonly PropDef[];\n  code: string;\n  usage: string;\n  customUsage?: string;\n  dependencies: readonly string[];\n  transformations: readonly string[];\n  notes?: readonly string[];\n}\n\nexport const components: Record<string, ComponentData> = ${JSON.stringify(components, null, 2)};\n\nexport function getRegistryIndex() {\n  return Object.values(components).map((component) => ({\n    name: component.name,\n    type: \"registry:ui\" as const,\n    dependencies: component.dependencies,\n    registryDependencies: [],\n    files: [{ path: \`components/ui/\${component.slug}.tsx\`, type: \"registry:ui\" as const }],\n  }));\n}\n\nexport function getRegistryComponent(slug: string) {\n  const component = components[slug];\n  if (!component) return null;\n  return {\n    name: component.name,\n    type: \"registry:ui\" as const,\n    dependencies: component.dependencies,\n    registryDependencies: [],\n    files: [{ path: \`components/ui/\${component.slug}.tsx\`, content: component.code, type: \"registry:ui\" as const }],\n  };\n}\n`;
}

if (process.argv[1] && resolve(process.argv[1]) === resolve(import.meta.filename)) {
  const output = renderRegistry();
  if (process.argv.includes("--check")) {
    if (!existsSync(outputFile) || readFileSync(outputFile, "utf8") !== output) {
      console.error("Generated registry is stale. Run pnpm registry:generate.");
      process.exitCode = 1;
    }
  } else writeFileSync(outputFile, output);
}