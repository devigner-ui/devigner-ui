{
  "name": "devignerui",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint --ui=tui",
    "clean": "turbo clean --ui=tui",
    "shot": "node scripts/shot.mjs",
    "og:shots": "node scripts/og-shots.mjs",
    "test": "node scripts/menu-path.check.mts && node scripts/catalog.check.mts",
    "registry:generate": "node scripts/registry/generate.mts",
    "registry:check": "node scripts/registry/generate.mts --check",
    "registry:validate": "node scripts/registry/validate.mts",
    "registry:fixtures": "node scripts/registry/compile-fixtures.mts",
    "registry:ci": "pnpm registry:check && pnpm registry:validate && pnpm registry:fixtures"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "playwright": "^1.63.0",
    "shiki": "^4.4.3",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@devigner-ui/icons": "3.3.0"
  }
}
